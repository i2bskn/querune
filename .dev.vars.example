# Copy to .dev.vars for local development with `wrangler dev`.
# Cookies use the Secure attribute and the __Host- prefix. Chrome and Firefox store them on
# http://localhost, but Safari does not, so use Chrome or Firefox for local development.

# The Deploy to Cloudflare button asks for every uncommented key in this file as a secret.
# Keep only JWT_SECRET uncommented; the other settings are plain variables.

# Required. At least 32 characters. Generate one with `openssl rand -hex 32`.
# Left empty on purpose so that a placeholder is never used in production.
JWT_SECRET=

# "password" (default) or "oidc"
# AUTH_MODE=password

# Required when AUTH_MODE=oidc. With AUTH_MODE=password, setting it enables passkeys for MFA.
# Passkeys need an HTTPS origin, so they do not work on http://localhost.
# APP_ORIGIN=https://querune.example.com

# Optional for AUTH_MODE=password (docs/settings.md). Which users must use MFA: "optional" (default), "admins"
# or "all". "admins" and "all" need APP_ORIGIN or PASSWORD_MFA_KEY.
# PASSWORD_MFA_POLICY=optional

# Optional for AUTH_MODE=password. Enables authenticator apps (TOTP) for MFA. 32 random bytes in standard base64;
# generate one with `openssl rand -base64 32`. Changing it makes the registered authenticator apps unusable.
# PASSWORD_MFA_KEY=

# Optional (docs/settings.md). The hash of new passwords: "scrypt" (default) or "pbkdf2". Any other value is a
# configuration error, whatever AUTH_MODE is. scrypt takes about 150-200ms of CPU per hash and pbkdf2 at 100000
# iterations about 17-56ms, both over the 10ms of the Workers Free plan. In a measurement in 2026-11 neither was cut
# off on the Free plan, but that is not guaranteed: if sign-ins fail on the CPU limit, set "pbkdf2" with fewer
# iterations (10000 to 100000, default 100000), or use Workers Paid.
# Existing hashes keep working after a change.
# PASSWORD_HASH_ALGORITHM=pbkdf2
# PASSWORD_PBKDF2_ITERATIONS=50000

# Required only when AUTH_MODE=oidc. OIDC_ISSUER is the issuer itself; a URL with /.well-known/ (the discovery URL)
# is a configuration error.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=querune
# OIDC_CLIENT_SECRET=dummy-secret

# For AUTH_MODE=oidc, required to sign in to a deployment without users. While there are no users, the first
# sign-in with this email creates the first admin; ignored once a user exists. Other users sign in only after an
# admin adds them on the users screen.
# INITIAL_ADMIN_EMAIL=admin@example.com

# Optional for AUTH_MODE=oidc. Set to "false" only when the IdP cannot send email_verified and every
# login method of the IdP verifies emails. Prefer making the IdP send it: with Cloudflare Access for SaaS and Google,
# add an OIDC claim email_verified from the IdP claim verified_email (docs/settings.md). Invited users are linked to
# the IdP account by email at their first sign-in, so an unverified login method could impersonate an invited user
# who has not signed in yet, or INITIAL_ADMIN_EMAIL.
# When the claim is present it must still be true. Review this setting whenever OIDC_ISSUER changes.
# OIDC_REQUIRE_EMAIL_VERIFIED=false

# Optional for AUTH_MODE=oidc. Set to "true" only when every login method of the IdP is Google (docs/settings.md).
# At the first sign-in, emails other than @gmail.com then need a non-empty hd claim (a Google Workspace account).
# Make sure the IdP sends hd first: without it, nobody but Gmail users can sign in for the first time. With
# Cloudflare Access for SaaS, add an OIDC claim hd from the IdP claim hd, not required (docs/settings.md).
# OIDC_REQUIRE_GOOGLE_HD=true

# Optional. The JSON of a Google service account key, on one line, for importing Search Console and GA4
# (docs/settings.md). Commented out so that the Deploy to Cloudflare button does not ask for it.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"querune@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
