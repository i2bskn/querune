---
import { LinkButton } from "@astrojs/starlight/components";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

// An illustration of the site screen: 28 days of clicks, with the day a memo was written. The totals are the example
// values in the API reference (GET /api/v1/sites/:id/insights).
const clicks = [
  28, 31, 26, 30, 33, 22, 19, 29, 32, 30, 34, 27, 21, 18, 31, 33, 35, 30, 36, 39, 41, 38, 30, 26, 42, 45, 43, 47,
];
const memoDay = 17;
const max = Math.max(...clicks);
const bar = { w: 6, gap: 4, h: 56 };
const chartWidth = clicks.length * (bar.w + bar.gap) - bar.gap;
---

<section class="gh-hero not-content" aria-labelledby="_top">
  <div class="gh-hero-copy">
    <p class="gh-eyebrow">
      <span class="gh-pill">セルフホスト</span>
      <span class="gh-dot" aria-hidden="true"></span>
      <span translate="no">Search Console · GA4 · Cloudflare Workers · MCP</span>
    </p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="gh-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="gh-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
    <div class="gh-deploy">
      <a class="gh-deploy-button" href="https://deploy.workers.cloudflare.com/?url=https://github.com/i2bskn/querune">
        <img src="https://deploy.workers.cloudflare.com/button" alt="Deploy to Cloudflare" width="166" height="32" />
      </a>
      <p>
        自分のCloudflareアカウントにデプロイします。表示されたURLを開いて<strong>最初に登録した人がadmin</strong
        >になるので、デプロイしたらすぐ登録してください。
      </p>
    </div>
  </div>

  <figure class="gh-flow" aria-labelledby="gh-flow-cap">
    <figcaption id="gh-flow-cap" class="sr-only">
      Search ConsoleとGA4のデータを毎日取り込み、実績とメモをまとめて保存する。AIはMCPでそれを読み、振り返りと次の行動を一緒に考える。
    </figcaption>

    <div class="gh-node">
      <span class="gh-node-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"
          ><circle cx="8.5" cy="8.5" r="5"></circle><path d="M12.2 12.2 17 17M6.2 10V8.5M8.5 10V6.5M10.8 10V7.8"
          ></path></svg
        >
      </span>
      <span class="gh-node-who" translate="no">Search Console · GA4</span>
      <span class="gh-node-note">サービスアカウントで読み取る</span>
    </div>

    <div class="gh-link" aria-hidden="true">
      <span class="gh-link-line"></span>
      <span class="gh-link-tag"><b>毎日</b>取り込む</span>
    </div>

    <div class="gh-card">
      <div class="gh-card-bar">
        <span class="gh-card-site">ブログ</span>
        <span>直近28日</span>
      </div>
      <dl class="gh-kpis">
        <div>
          <dt>クリック</dt>
          <dd>1,073<small>+23%</small></dd>
        </div>
        <div>
          <dt>表示回数</dt>
          <dd>29,989</dd>
        </div>
        <div>
          <dt>セッション</dt>
          <dd>5,696</dd>
        </div>
      </dl>
      <svg
        class="gh-chart"
        viewBox={`0 0 ${chartWidth} ${bar.h + 8}`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <line
          class="gh-chart-memo"
          x1={memoDay * (bar.w + bar.gap) + bar.w / 2}
          x2={memoDay * (bar.w + bar.gap) + bar.w / 2}
          y1="0"
          y2={bar.h + 8}></line>
        {
          clicks.map((c, i) => {
            const h = Math.round((c / max) * bar.h);
            return (
              <rect
                class:list={["gh-bar", { "gh-bar-after": i > memoDay }]}
                x={i * (bar.w + bar.gap)}
                y={bar.h + 8 - h}
                width={bar.w}
                height={h}
                rx="1.5"
                style={`--i:${i}`}
              />
            );
          })
        }
      </svg>
      <p class="gh-card-memo"><span aria-hidden="true"></span>メモ「タイトルを変更」</p>
    </div>

    <div class="gh-link gh-link-ai" aria-hidden="true">
      <span class="gh-link-line"></span>
      <span class="gh-link-tag"><b>MCP</b> query_search_performance</span>
    </div>

    <div class="gh-node gh-node-ai">
      <span class="gh-node-icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="18" height="18"
          ><path d="M10 2.5l1.6 4.4 4.4 1.6-4.4 1.6L10 14.5l-1.6-4.4L4 8.5l4.4-1.6z" fill="currentColor"></path></svg
        >
      </span>
      <span class="gh-node-who">AI<small>Claudeなど</small></span>
      <q class="gh-bubble">今週のサイトの状況は？</q>
      <span class="gh-node-note">実績と前回までのメモを読み、次の行動を一緒に考える</span>
    </div>
  </figure>
</section>

<style>
  .gh-hero {
    display: grid;
    gap: 3rem;
    padding-block: 1.5rem 3rem;
  }
  .gh-hero > * {
    min-width: 0;
  }
  @media (min-width: 62rem) {
    .gh-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: 4rem;
      padding-block: 3.5rem 4.5rem;
    }
  }

  .gh-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0 0 1.5rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-3);
  }
  .gh-pill {
    padding: 0.125rem 0.6rem;
    border: 1px solid var(--gh-line);
    border-radius: 999px;
    font-family: var(--__sl-font);
    color: var(--sl-color-gray-2);
  }
  .gh-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.125rem, 1.35rem + 3vw, 3.5rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: 0;
    color: var(--sl-color-white);
    font-feature-settings: "palt";
    word-break: auto-phrase;
    text-wrap: balance;
  }
  .gh-tagline {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.9;
    color: var(--sl-color-gray-2);
    word-break: auto-phrase;
    text-wrap: pretty;
  }

  .gh-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }
  .gh-actions :global(.sl-link-button.primary) {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--gh-on-accent);
    font-weight: 600;
  }
  .gh-actions :global(.sl-link-button) {
    border-radius: 999px;
  }

  .gh-deploy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    max-width: 34rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .gh-deploy-button {
    flex: none;
    display: inline-flex;
    border-radius: 6px;
  }
  .gh-deploy-button img {
    display: block;
  }
  .gh-deploy p {
    flex: 1 1 14rem;
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.7;
    color: var(--sl-color-gray-3);
  }
  .gh-deploy strong {
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }

  /* ---------- Flow: the results come in every day, the AI reads them with the memos ---------- */

  .gh-flow {
    display: grid;
    justify-items: center;
    margin: 0;
    padding: 1.5rem clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--gh-line);
    border-radius: 16px;
    background:
      linear-gradient(var(--gh-grid) 1px, transparent 1px) 0 0 / 100% 24px,
      linear-gradient(90deg, var(--gh-grid) 1px, transparent 1px) 0 0 / 24px 100%,
      var(--gh-surface);
  }
  .gh-node {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.35rem 0.7rem;
    width: min(100%, 22rem);
  }
  .gh-node-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--gh-line);
    border-radius: 50%;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }
  .gh-node-ai .gh-node-icon {
    color: var(--gh-accent-text);
  }
  .gh-node-who {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .gh-node-who small {
    font-size: var(--sl-text-xs);
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }
  .gh-bubble,
  .gh-node-note {
    grid-column: 2;
    justify-self: start;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .gh-node-note {
    word-break: auto-phrase;
    font-size: var(--sl-text-xs);
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }
  .gh-bubble {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--gh-line);
    border-radius: 4px 14px 14px 14px;
    background: var(--sl-color-black);
    quotes: "「" "」";
  }

  .gh-link {
    position: relative;
    display: grid;
    place-items: center;
    height: 3.25rem;
  }
  .gh-link-line {
    position: absolute;
    inset: 0 auto;
    left: 50%;
    width: 0;
    border-left: 1.5px dashed color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
  }
  .gh-link-line::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: -5px;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid var(--sl-color-accent);
    border-bottom: 1.5px solid var(--sl-color-accent);
    transform: rotate(45deg);
  }
  .gh-link-tag {
    position: relative;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--gh-line);
    border-radius: 999px;
    background: var(--gh-surface);
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .gh-link-ai .gh-link-tag {
    font-family: var(--__sl-font-mono);
  }
  .gh-link-tag b {
    margin-right: 0.3rem;
    font-family: var(--__sl-font-mono);
    font-weight: 500;
    color: var(--gh-accent-text);
  }

  .gh-card {
    width: min(100%, 22rem);
    padding: 1rem 1.15rem 1.1rem;
    border: 1px solid var(--gh-line);
    border-radius: 12px;
    background: var(--sl-color-black);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.55);
  }
  .gh-card-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
  }
  .gh-card-site {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .gh-kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .gh-kpis dt {
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
  }
  .gh-kpis dd {
    margin: 0.1rem 0 0;
    font-family: var(--__sl-font-mono);
    font-size: 1rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }
  .gh-kpis small {
    display: block;
    font-size: var(--sl-text-2xs);
    color: var(--gh-accent-text);
  }
  .gh-chart {
    display: block;
    width: 100%;
    height: 4rem;
    margin-top: 0.9rem;
    overflow: visible;
  }
  .gh-bar {
    fill: var(--sl-color-gray-4);
  }
  .gh-bar-after {
    fill: var(--sl-color-gray-2);
  }
  .gh-chart-memo {
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .gh-card-memo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.6rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .gh-card-memo span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 2px;
    background: var(--sl-color-accent);
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gh-hero-copy > *,
    .gh-flow {
      animation: gh-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .gh-hero-copy > :nth-child(2) {
      animation-delay: 60ms;
    }
    .gh-hero-copy > :nth-child(3) {
      animation-delay: 120ms;
    }
    .gh-hero-copy > :nth-child(4) {
      animation-delay: 180ms;
    }
    .gh-hero-copy > :nth-child(5) {
      animation-delay: 240ms;
    }
    .gh-flow {
      animation-delay: 160ms;
    }
    /* The days come in one after another. */
    .gh-bar {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: gh-grow 420ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(800ms + var(--i) * 45ms);
    }
    .gh-link-line {
      animation: gh-draw 600ms ease-out both;
      animation-delay: 600ms;
      transform-origin: top;
    }
    .gh-link-ai .gh-link-line {
      animation-delay: calc(800ms + 28 * 45ms);
    }
  }
  @keyframes gh-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes gh-grow {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes gh-draw {
    from {
      transform: scaleY(0);
    }
  }

  @media (max-width: 40rem) {
    .gh-dot {
      display: none;
    }
  }
</style>
